#!/bin/sh
# auto-formats staged java files with spotless before committing

STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.java')
if [ -z "$STAGED_JAVA_FILES" ]; then
	exit 0
fi

./gradlew spotlessApply -q
if [ $? -ne 0 ]; then
	echo "spotless failed, aborting commit"
	exit 1
fi

echo "$STAGED_JAVA_FILES" | xargs git add
