{
	"schemaVersion": 1,
	"id": "configurable-hunger",
	"version": "${version}",
	"name": "Configurable Hunger",
	"description": "Allows you to take control of hunger mechanics, decoupling hunger difficulty from world difficulty.",
	"authors": [
		"KeeningDawn"
	],
	"contact": {
		"issues": "https://github.com/KeeningDawn/configurable-hunger/issues",
		"sources": "https://github.com/KeeningDawn/configurable-hunger"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/configurable-hunger/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.keeningdawn.configurablehunger.ConfigurableHunger"
		],
		"client": [
			"io.github.keeningdawn.configurablehunger.client.ConfigurableHungerClient"
		],
		"modmenu": [
			"io.github.keeningdawn.configurablehunger.client.ConfigurableHungerModMenuIntegration"
		]
	},
	"mixins": [
		"configurable-hunger.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=1.20 <1.21",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}